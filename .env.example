# --- Booking form ---------------------------------------------------------
# Where booking-form submissions are sent.
#
# 1. Sign up at https://formspree.io (the free tier covers 50 submissions/month)
# 2. Create a form, point it at lifeonfullvolume@gmail.com
# 3. Copy the endpoint it gives you into .env.local (and into Vercel's
#    environment variables when you deploy)
#
# Leave this unset and the booking form still works — it falls back to opening
# the visitor's mail client with all the fields filled in.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id


# --- Analytics ------------------------------------------------------------
# Plausible is cookieless, so it needs NO cookie-consent banner under GDPR —
# which also means it counts every visitor, not just the ones who accept a
# banner. Set this to the site's domain exactly as registered in Plausible.
#
# Leave it unset and no analytics script is loaded at all.
VITE_PLAUSIBLE_DOMAIN=lifeonfullvolume.com
